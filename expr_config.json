{
    "output_dir": "./Results",
    "codename": "MXC",
    "expr_num": 58,
    "comment": "CNN.",

    "dataset": "./Dataset/CHES_2025/CHES_Challenge.h5",
    "train_size": 480000,
    "val_size": 20000,
    "test_size": 100000,
    "leakage": "ID",

    "denoising": true,
    "denoising_args": {
        "fs": 1000,
        "notch_freqs": [10, 20, 25, 30, 40, 43.15, 60, 80, 125],
        "Q": 100,
        "atten_db": 20
    },

    "fixing_data_drift": true,

    "data_augmentation": false,
    "aug_gaussian_noise": 0.02,
    "aug_random_shift": 0,

    "model": "cnn",
    "model_args": {
        "input_size": 7000,
        "input_dim": 1,
        "output_size": 50,
        "output_dim": 256,
        "kernel_sizes": [15, 7, 5, 4, 3, 3],
        "layer_strides": [3, 2, 1, 1, 1, 1],
        "padding": 2,

        "pooling_type": "average_pool",
        "activation": "relu",
        "mlp_head": true,
        "mlp_head_args": {
            "input_dim": 256,
            "output_dim": 256,
            "layers": 2,
            "hidden_dim": 400,
            "activation": "relu"
        }
    },

    "optimizer": "Adam",
    "optimizer_args": {},

    "lr": 0.0001,
    "batch_size": 1000,
    "num_epochs": 5,

    "num_attacks": 50
}