{
    "output_dir": "./Results",
    "codename": "X",
    "expr_num": 33,
    "comment": "",

    "dataset": "./Dataset/CHES_2025/CHES_Challenge.h5",
    "train_size": 480000,
    "val_size": 20000,
    "test_size": 100000,
    "leakage": "ID",

    "denoising": true,
    "denoising_args": {
        "fs": 1000,
        "notch_freqs": [20, 40, 60, 80],
        "Q": 100,
        "atten_db": 20
    },

    "fixing_data_drift": true,

    "data_augmentation": true,
    "aug_gaussian_noise": 0.03,
    "aug_random_shift": 3,

    "model": "mlp",
    "model_args": {
        "input_window": false,
        "input_window_args": {
            "start_indices": 0,
            "window_size": 7000
        },
        "gated": false,
        "input_dim": 7000,
        "hidden_dims": [
            300,
            300,
            300,
            300
        ],
        "output_dim": 256,
        "activation": "relu"
    },

    "optimizer": "Adam",
    "optimizer_args": {},

    "lr": 0.0001,
    "batch_size": 3000,
    "accumulation_steps": 1,
    "num_epochs": 3,

    "num_attacks": 100
}